#!/bin/bash
#SBATCH -J t2_dl_rl
#SBATCH -o /home/yj576/logs/t2_dl_rl_%j.out
#SBATCH -e /home/yj576/logs/t2_dl_rl_%j.err
#SBATCH -N 1
#SBATCH -n 1
#SBATCH --cpus-per-task=4
#SBATCH --mem=16G
#SBATCH -t 2:00:00
#SBATCH --partition=fang   # CPU-only; no GPU requested, so no preemption
#SBATCH --get-user-env
set -eo pipefail
cd /home/yj576/proj/transformer-transformer

# rl_policies.zip (~10 GB): RL experts, choice_to_ckpt_path.json, option stores, RoboToken bank
URL=https://real.stanford.edu/transformer-transformer
DL=$HOME/downloads/t2   # same SHA256SUMS as checkpoints/data
mkdir -p "$DL"
wget -nv -c -P "$DL" $URL/rl_policies.zip
(cd "$DL" && sha256sum -c SHA256SUMS --ignore-missing)
unzip -q -n "$DL/rl_policies.zip" -d .   # -n: never overwrite existing files
unzip -Z1 "$DL/rl_policies.zip" | cut -d/ -f1 | sort -u   # top-level entries unpacked

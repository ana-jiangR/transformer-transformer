#!/bin/bash
#SBATCH -J t2_gpu_check
#SBATCH -o /home/yj576/logs/t2_gpu_check_%j.out
#SBATCH -e /home/yj576/logs/t2_gpu_check_%j.err
#SBATCH -N 1
#SBATCH -n 1
#SBATCH --cpus-per-task=4
#SBATCH --mem=16G
#SBATCH --gres=gpu:nvidia_rtx_a6000:1
#SBATCH -t 0:15:00
#SBATCH --partition=fang
#SBATCH --get-user-env
# Which env actually runs on this node's driver: .venv (CUDA 13) vs .venv-cu12 (CUDA 12.6)
cd /home/yj576/proj/transformer-transformer
export WANDB_MODE=offline

hostname
nvidia-smi --query-gpu=name,driver_version,memory.total --format=csv

for ENV in .venv .venv-cu12; do
  echo "===== $ENV"
  $ENV/bin/python - <<'EOF'
import torch
print('torch', torch.__version__, 'cuda', torch.version.cuda, 'avail', torch.cuda.is_available())
if torch.cuda.is_available():
    x = torch.randn(2048, 2048, device='cuda')
    print('torch matmul ok', (x @ x).sum().item() != 0)
import jax, jax.numpy as jnp
print('jax', jax.__version__, jax.devices())
y = jnp.ones((2048, 2048))
print('jax matmul on', (y @ y).devices())
EOF
  echo "exit=$?"
done

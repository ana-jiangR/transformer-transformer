#!/bin/bash
#SBATCH -J t2_build_cu12
#SBATCH -o /home/yj576/logs/t2_build_cu12_%j.out
#SBATCH -e /home/yj576/logs/t2_build_cu12_%j.err
#SBATCH -N 1
#SBATCH -n 1
#SBATCH --cpus-per-task=8
#SBATCH --mem=28G
#SBATCH -t 1:00:00
#SBATCH --partition=fang   # CPU-only; no GPU requested, so no preemption
#SBATCH --get-user-env
# Second env for driver-570 nodes (CUDA <= 12.8): same locked versions as .venv,
# but torch/torchvision from the cu126 index and jax[cuda12]. pyproject/uv.lock untouched.
set -eo pipefail
cd /home/yj576/proj/transformer-transformer
export PATH=$HOME/.local/bin:$PATH   # uv
ENV=.venv-cu12
REQ=$(mktemp)

# everything from uv.lock except the CUDA 13 stack (cuda-toolkit 13 would pull nvidia-* 13 libs)
uv export --frozen --extra dev --no-hashes --no-emit-project \
  | grep -vE '^(torch|torchvision|triton|jax-cuda13|nvidia-|cuda-toolkit|cuda-bindings)' > "$REQ"

uv venv "$ENV" --python 3.12 --clear
uv pip install --python "$ENV" -r "$REQ"
uv pip install --python "$ENV" torch==2.13.0 torchvision==0.28.0 \
  --index-url https://pypi.org/simple --extra-index-url https://download.pytorch.org/whl/cu126
uv pip install --python "$ENV" "jax[cuda12]==0.10.2"
uv pip install --python "$ENV" -e . --no-deps   # the t2 package itself
rm -f "$REQ"

source "$ENV/bin/activate"
python -c "import torch, torchvision, jax, t2; print('torch', torch.__version__, torch.version.cuda); print('jax', jax.__version__)"
uv pip list --python "$ENV" | grep -iE '^(torch|jax|nvidia-cud)'
pytest tests/robotok -q   # CPU sanity; expect 811 passed
